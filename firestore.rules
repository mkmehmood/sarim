rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    function meRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function me() { return get(meRef()).data; }

    function active() {
      return signedIn()
        && request.auth.token.email != null
        && exists(meRef())
        && me().get('approved', true) != false
        && me().get('email', request.auth.token.email).lower() == request.auth.token.email.lower();
    }
    function teamOwner() { return me().get('ownerUid', request.auth.uid); }
    function isAdmin() { return active() && me().get('role', 'user') == 'admin'; }
    function inMyTeam(uid) { return active() && teamOwner() == uid; }
    function isMemberOfMyTeam(data) { return data.get('ownerUid', null) == teamOwner(); }
    function dataAccess(uid, subcollection, docId) {
      return inMyTeam(uid)
        && (isAdmin() || !(subcollection == 'settings' && docId == 'accounts'));
    }

    match /users/{uid} {
      allow read: if isSelf(uid)
        || inMyTeam(uid)
        || (isAdmin() && isMemberOfMyTeam(resource.data));

      allow create: if isAdmin()
        && !isSelf(uid)
        && request.resource.data.get('ownerUid', null) == teamOwner();

      allow update: if (
        isSelf(uid) && active()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastWrite', 'lastLoginAt', 'authProviders', 'displayName'])
      ) || (
        inMyTeam(uid) && !isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastWrite'])
      ) || (
        isAdmin() && isSelf(uid) && teamOwner() == uid
      ) || (
        isAdmin() && !isSelf(uid)
        && isMemberOfMyTeam(resource.data)
        && request.resource.data.get('ownerUid', null) == resource.data.get('ownerUid', null)
      );

      allow delete: if isAdmin() && !isSelf(uid) && isMemberOfMyTeam(resource.data);
    }

    match /users/{uid}/{subcollection}/{docId} {
      allow read, write: if dataAccess(uid, subcollection, docId);
    }

    match /users/{uid}/{subcollection}/{docId}/{rest=**} {
      allow read, write: if dataAccess(uid, subcollection, docId);
    }
  }
}
